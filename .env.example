# ============================================
# Flora Store — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# ── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── App ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Flora Store
NEXT_PUBLIC_APP_LOCALE=ar
NEXT_PUBLIC_CURRENCY=SAR
NEXT_PUBLIC_CURRENCY_SYMBOL=ر.س

# ── WhatsApp ──────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=966501234567

# ── Social Media ──────────────────────────────
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/flor.astore123
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@florastore04
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/share/1639sCDaVN/
NEXT_PUBLIC_WHATSAPP_GROUP=https://chat.whatsapp.com/DkS6LUMRu12KywzsZUwZ1r

# ── Payment Gateways ──────────────────────────
# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret

# Moyasar (مدى / Apple Pay / Google Pay / STC Pay)
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_your_moyasar_key
MOYASAR_SECRET_KEY=sk_test_your_moyasar_secret

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ── Installment Providers ─────────────────────
# Tabby
NEXT_PUBLIC_TABBY_PUBLIC_KEY=pk_test_your_tabby_key
TABBY_SECRET_KEY=sk_test_your_tabby_secret
NEXT_PUBLIC_TABBY_MERCHANT_CODE=your_merchant_code

# Tamara
NEXT_PUBLIC_TAMARA_API_URL=https://api.tamara.co
TAMARA_NOTIFICATION_TOKEN=your_tamara_notification_token
TAMARA_AUTH_TOKEN=your_tamara_auth_token

# ── Shipping ──────────────────────────────────
# Aramex
ARAMEX_ACCOUNT_NUMBER=your_aramex_account
ARAMEX_USERNAME=your_aramex_username
ARAMEX_PASSWORD=your_aramex_password

# ── Email ─────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@florastore.com

# ── Storage ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=flora-products

# ── Analytics ─────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Admin ─────────────────────────────────────
ADMIN_SECRET_KEY=your_super_secret_admin_key

# ── Rate Limiting ─────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
